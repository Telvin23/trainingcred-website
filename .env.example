# Set these in Vercel > Project > Settings > Environment Variables (never commit real values)
DATABASE_URL=            # Neon Postgres connection string (added automatically if you connect Neon from Vercel Storage)
ADMIN_PASSWORD=          # password for /admin (long and random)
RESEND_API_KEY=          # optional: email alert for each new booking (resend.com)
NOTIFY_EMAIL=info@trainingcred.com
NOTIFY_FROM=Trainingcred Website <bookings@trainingcred.com>
CRON_SECRET=             # any long random text; Vercel uses it to call the 7 am follow-up email (api/cron/followups.js)
